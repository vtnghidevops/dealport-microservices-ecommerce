# Mail Service Configuration
MAIL_DOMAIN=example.com
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=your_password
FROM_NAME=E-commerce Store
FROM_ADDR=no-reply@example.com

# Authentication Service Configuration
AUTH_DB_HOST=postgres-auth
AUTH_DB_PORT=5432
AUTH_DB_USER=postgres-auth
AUTH_DB_PASSWORD=your_password
AUTH_DB_NAME=auth
AUTH_DB_SSLMODE=disable
JWT_ACCESS_SECRET=your_secret_key
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_ACCESS_DURATION=15
JWT_REFRESH_DURATION=168

# User Service Configuration
USER_DB_HOST=postgres-users
USER_DB_PORT=5432
USER_DB_USER=postgres-users
USER_DB_PASSWORD=your_password
USER_DB_NAME=users
USER_DB_SSLMODE=disable

# Product Service Configuration
PRODUCT_DSN=host=postgres-products port=5432 user=postgres-products password=your_password dbname=products sslmode=disable timezone=UTC connect_timeout=5

# MongoDB Configuration
MONGO_USERNAME=admin
MONGO_PASSWORD=your_password 