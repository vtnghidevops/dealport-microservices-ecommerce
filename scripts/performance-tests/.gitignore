# Performance test results and temporary files

# Test results directory
results/
*.json
*.log

# Temporary files
*.tmp
*.temp

# Node modules (if using npm)
node_modules/

# Environment files with sensitive data
.env
.env.local
.env.staging
.env.production

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

